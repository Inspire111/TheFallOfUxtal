--- !u!1001 &1920716341
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: -969426548830116733, guid: c794586a7f1f0f7439184f85304b4539, type: 3}
      propertyPath: m_IsTrigger
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 3283204500101150994, guid: c794586a7f1f0f7439184f85304b4539, type: 3}
      propertyPath: m_Name
      value: Barman
      objectReference: {fileID: 0}
    - target: {fileID: 5402411782391686167, guid: c794586a7f1f0f7439184f85304b4539, type: 3}
      propertyPath: npcName
      value: Barman
      objectReference: {fileID: 0}
    - target: {fileID: 5402411782391686167, guid: c794586a7f1f0f7439184f85304b4539, type: 3}
      propertyPath: firstInteraction.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 5402411782391686167, guid: c794586a7f1f0f7439184f85304b4539, type: 3}
      propertyPath: repeatInteraction.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 5402411782391686167, guid: c794586a7f1f0f7439184f85304b4539, type: 3}
      propertyPath: 'firstInteraction.Array.data[0]'
      value: Hmph... Assieds-toi, gamin. Ici, on boit. On pose pas de questions.
      objectReference: {fileID: 0}
    - target: {fileID: 5402411782391686167, guid: c794586a7f1f0f7439184f85304b4539, type: 3}
      propertyPath: 'firstInteraction.Array.data[1]'
      value: "Tu cherches des gens pr\xEAts \xE0 se battre ? Mauvaise pioche... Personne
        veut crever pour des histoires qui les regardent pas."
      objectReference: {fileID: 0}
    - target: {fileID: 5402411782391686167, guid: c794586a7f1f0f7439184f85304b4539, type: 3}
      propertyPath: 'firstInteraction.Array.data[2]'
      value: " Mais, avec quelques pi\xE8ces, j\u2019pourrais peut-\xEAtre te souffler
        deux-trois noms."
      objectReference: {fileID: 0}
    - target: {fileID: 5402411782391686167, guid: c794586a7f1f0f7439184f85304b4539, type: 3}
      propertyPath: 'firstInteraction.Array.data[3]'
      value: " Va voir au fond, pr\xE8s des tables noires. Y\u2019a toujours des
        types assez fous pour \xE9couter un inconnu."
      objectReference: {fileID: 0}
    - target: {fileID: 5402411782391686167, guid: c794586a7f1f0f7439184f85304b4539, type: 3}
      propertyPath: 'firstInteraction.Array.data[4]'
      value: "Marche, enfant du doute. Tes pas finiront par te montrer la v\xE9rit\xE9."
      objectReference: {fileID: 0}
    - target: {fileID: 5402411782391686167, guid: c794586a7f1f0f7439184f85304b4539, type: 3}
      propertyPath: 'repeatInteraction.Array.data[0]'
      value: " T\u2019as pas compris la premi\xE8re fois ?"
      objectReference: {fileID: 0}
    - target: {fileID: 5402411782391686167, guid: c794586a7f1f0f7439184f85304b4539, type: 3}
      propertyPath: 'repeatInteraction.Array.data[1]'
      value: "Toujours l\xE0 ? Fais pas fuir mes clients\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 5402411782391686167, guid: c794586a7f1f0f7439184f85304b4539, type: 3}
      propertyPath: 'repeatInteraction.Array.data[2]'
      value: "Hmph... T\u2019es tenace, j\u2019te l\u2019accorde."
      objectReference: {fileID: 0}
    - target: {fileID: 7656968047359939086, guid: c794586a7f1f0f7439184f85304b4539, type: 3}
